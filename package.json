{
  "name": "@catalysync/code-review",
  "version": "0.1.0",
  "description": "Layered LLM code review for any repo. Composes language + framework + project rules; posts inline GitHub suggestions.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "code-review": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "prompts-vendored",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@octokit/rest": "^21.0.2",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "kleur": "^4.1.5",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catalysync/code-review.git"
  },
  "keywords": [
    "code-review",
    "claude",
    "claude-code",
    "anthropic",
    "github",
    "pull-request",
    "llm",
    "static-analysis"
  ],
  "engines": {
    "node": ">=20"
  }
}
